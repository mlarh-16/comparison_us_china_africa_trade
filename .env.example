# Copy this file to `.env` and fill in your UN Comtrade API key(s).
# `.env` is gitignored — never commit real keys.
# Get a key from https://comtradedeveloper.un.org/

COMETRADE_API_KEY=your_comtrade_primary_key
# Optional fallback key (used if the primary is rate-limited):
COMETRADE_SECONDARY_KEY=
